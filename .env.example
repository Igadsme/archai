# Copy to `.env` (git-ignored) and fill in. Never commit real values.
# Full reference: docs/deploy/ENV.md. Production checklist: docs/deploy/PRODUCTION.md.

# development | production. Production refuses to boot without a key, https CORS origins,
# DATABASE_URL and ARCHAI_REDIS_URL, and turns off /docs unless ARCHAI_DOCS_ENABLED=1.
ARCHAI_ENV=development

# Compose Postgres password (required by docker-compose.yml).
POSTGRES_PASSWORD=

# Write key. Prefer the hash so the plaintext never sits in the service environment:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"        # keep this secret
#   printf %s '<key>' | sha256sum | cut -d' ' -f1                        # paste this below
ARCHAI_API_KEY_SHA256=
# ARCHAI_API_KEY=
ARCHAI_REQUIRE_API_KEY=0
# 1 = reads (jobs, experiments, models, audit) also need the key; /health and /readiness stay public.
ARCHAI_PROTECT_READS=0

# Comma-separated Studio origins allowed by CORS. Production: explicit https:// origins only.
ARCHAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public API URL baked into the Studio bundle at build time.
ARCHAI_PUBLIC_API_URL=http://localhost:8000

# Reverse-proxy address(es) trusted for X-Forwarded-For (needed for per-client rate limits).
FORWARDED_ALLOW_IPS=127.0.0.1
WEB_CONCURRENCY=2

# Worker benchmark archive (checksum-gated). Leave empty unless the worker profile is used.
ARCHAI_NATS_BENCH_PATH=
ARCHAI_NATS_BENCH_SHA256=
ARCHAI_NATS_BENCH_INDICES=
ARCHAI_NATS_BENCH_SEARCH_SPACE=tss
